# Copy to `.env`. Nothing here is required for the local/free path — every key
# has a working default. Add API keys only to use hosted models as the LLM judge.

# ---- Optional hosted LLM for the judge (blank = 100% free/local) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=

# ---- Local model backend (free, default) ----
USE_LOCAL_LLM=true
OLLAMA_URL=http://localhost:11434

# ---- Infra (match docker-compose; override only if you change ports) ----
KAFKA_BROKERS=localhost:9092
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=telemetry

# ---- Classifier: below this confidence, a turn routes to the LLM judge ----
LOW_CONF_THRESHOLD=0.75
